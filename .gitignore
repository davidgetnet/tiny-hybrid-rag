# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Build and package artifacts
build/
dist/
*.egg-info/
*.egg
wheels/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Local ML/model caches
.cache/
.huggingface/
huggingface_cache/
model-cache/

# Generated local database and container state
data/chroma/
data/chroma-server/*
!data/chroma-server/.gitkeep
.docker/
docker-data/

# Personal learning notes
learning/*
!learning/infra/
!learning/infra/**
